# --- Server ---
PORT=8080
DATA_DIR=data
APP_VERSION=dev

# --- Model provider ---
# mock: deterministic offline provider, no key required (default for demos)
# openai: any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2048
# Used for every call's cost record. Adjust to your provider's current price.
LLM_INPUT_USD_PER_MTOK=0.27
LLM_OUTPUT_USD_PER_MTOK=1.10
MOCK_STEP_LATENCY_MS=350

# --- Orchestrator defaults ---
RUN_MAX_TOKENS=60000
RUN_MAX_DURATION_SECONDS=600
RUN_MAX_DEPTH=2
RUN_MAX_CONCURRENCY=4
RUN_MAX_AGENTS=20
AGENT_MAX_STEPS=8
SPAWN_CONTEXT_MAX_CHARS=6000
